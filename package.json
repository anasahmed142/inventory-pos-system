{
  "name": "inventory-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Offline-First Inventory, POS, and Khata Management System (Tauri 2.0 + React + NestJS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "turbo run dev --filter=@inventory/desktop",
    "dev:web": "turbo run dev --filter=@inventory/web",
    "dev:server": "turbo run dev --filter=@inventory/server",
    "build": "turbo run build",
    "test": "turbo run test",
    "tauri:build": "pnpm --filter=@inventory/desktop tauri build"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.1.0"
}